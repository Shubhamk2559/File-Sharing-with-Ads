# Main (manager) bot token from BotFather
MAIN_BOT_TOKEN=

# Tumhara Telegram numeric user ID (sirf tum main bot chala sakoge)
OWNER_ID=

# MongoDB Atlas connection string
MONGO_URI=
DB_NAME=filebot

# Public https URL of THIS service, e.g. https://myapp-myorg.koyeb.app (https required in production, no trailing slash)
BASE_URL=

# Long random string, >= 16 chars in production (e.g. `openssl rand -hex 24`). Telegram's webhook header secret is derived from it.
WEBHOOK_SECRET=

# Private channels ke IDs (-100 se shuru)
PRIMARY_CHANNEL=
BACKUP_CHANNEL=

# Koyeb: Dockerfile builder (CMD `python serve.py`), exposed port 8000, health check path /readyz. See KOYEB.md.
# PORT is injected by the platform (default 8000); do not hard-code a different one in the image.
# Put every secret in Koyeb Secrets, never in the repo / Dockerfile / build args. This file is documentation only (it is not read).

# ---------------- Security profile (READ THIS FIRST) ----------------
# production (DEFAULT when unset) = fail closed:
#   * Monetag reward verification is the server-to-server POSTBACK only (AD_VERIFY_MODE=postback is forced; "legacy" refuses to start)
#   * MONETAG_POSTBACK_SECRET is REQUIRED: 16-128 chars of A-Z a-z 0-9 . _ ~ -   (e.g. `openssl rand -hex 24`). Missing/weak => the app will not start.
#   * Tads.me can NOT unlock files (it has no server-side verification); TADS_ALLOW_CLIENT_REWARD is ignored.
# development / test = local testing only (legacy browser verification and client-attested rewards allowed). NEVER use on a live deployment.
APP_ENV=production
MONETAG_POSTBACK_SECRET=
# AD_VERIFY_MODE=postback            # production: leave unset (postback is the only accepted value)
# AD_ATTEMPT_MAX_AGE=600             # seconds an ad attempt / its postback stays valid (30..3600)
# MONETAG_POSTBACK_REQUIRE_TELEGRAM_ID=true   # reject postbacks without telegram_id. Only set false if Monetag does not send it for your zone.

# ---------------- Smart Ads (Tads.me + Monetag) ----------------
# ON by default (Monetag first, Tads.me fallback + ad-gate). Set false only to go back to the old Monetag-only flow.
SMART_ADS_ENABLED=true
# Bearer token for /admin/ads (dashboard + API). Unset => admin endpoints return 404.
ADS_ADMIN_TOKEN=
# Tads.me: fullscreen widget ID
TADS_WIDGET_ID=
TADS_DEBUG=false
# Tads documents no server-side reward verification, so its browser callback is only "client_attested".
# APP_ENV=production: ignored (Tads is never served / never unlocks a file). Development: true lets Tads act as the fallback network.
TADS_ALLOW_CLIENT_REWARD=false

# ---- Ad gate (see README "Ad gate") ----
# Full Monetag->Tads rounds tried before the ad-blocker check
GATE_ROUNDS=3
# After all rounds showed NO ad: clean device => file is delivered, blocker/unverifiable => no file. false = never deliver without an ad.
GATE_GRACE=true
# Which failures count as "no ad available" (never add blocked/error here)
# GATE_GRACE_REASONS=no_fill,timeout
# GATE_MIN_TOTAL_SECONDS=8       # grace only this long after the first ad attempt
# GATE_CHALLENGE_TTL=90          # seconds a solved blocker challenge stays valid
# GATE_GRACE_MAX_PER_HOUR=20     # per-user cap on no-ad deliveries
# GATE_PROBE_TADS=true           # unreachable Tads host counts as a blocker (set false if Tads is blocked in your region)
# Optional tuning
# ADS_UNSHOWN_LOCK_SECONDS=25    # an attempt that never displayed frees the user's ad slot after this long
# ADS_SHOWN_LOCK_SECONDS=180     # a displayed ad holds the slot this long (video + verification wait)
# SESSION_TTL=1800               # Mini App session lifetime (Mongo TTL index on sessions.created)

# ---------------- Batch 2: shared rate limiting (MongoDB, works across all instances) ----------------
# Number of reverse proxies in front of the app that APPEND to X-Forwarded-For (Koyeb/Render: normally 1). Only the entry added by
# YOUR proxy is trusted; a client-supplied X-Forwarded-For can no longer pick its own rate-limit bucket. 0 = ignore the header.
# VERIFY after deploying: if every user shows the same IP in the logs (ip=...) this number is wrong for your platform.
TRUSTED_PROXY_COUNT=1
# Every limit is "<max>/<window seconds>". Defaults shown. Invalid values stop the app at startup.
# RL_API_START_IP=90/60        RL_API_REPORT_IP=90/60       RL_API_DONE_IP=90/60        (Mini App, per IP: shared carrier NATs, keep generous)
# RL_API_START_USER=20/60      RL_API_REPORT_USER=20/60     RL_API_DONE_USER=20/60      (Mini App, per authenticated Telegram user)
# RL_GATE_CHALLENGE_IP=600/60  RL_GATE_GRACE_IP=600/60      RL_GATE_CHALLENGE_USER=20/60  RL_GATE_GRACE_USER=20/60
# RL_BAIT_IP=3000/60
# RL_LEGACY_START_IP=90/60 RL_LEGACY_FAIL_IP=90/60 RL_LEGACY_DONE_IP=90/60 RL_LEGACY_GRACE_IP=90/60   (non-smart flow)
# RL_LEGACY_START_USER=20/60 RL_LEGACY_FAIL_USER=20/60 RL_LEGACY_DONE_USER=20/60 RL_LEGACY_GRACE_USER=20/60
# RL_LINK_IP=120/60            (public /f/<token> links)
# RL_FILE_DELIVERY_USER=30/3600 (files actually delivered per user per hour)
# RL_BOT_START_USER=10/60      RL_BOT_MSG_USER=30/60        (Telegram bot: opening links / menu + text)
# RL_ADMIN_IP=120/60  RL_ADMIN_FAIL_IP=10/600  RL_MONETAG_ADMIN_IP=120/60  RL_MONETAG_ADMIN_FAIL_IP=10/600
# RL_POSTBACK_FAIL_IP=20/600   (wrong postback secrets; a CORRECT secret is never limited)
# RL_WEBHOOK_FAIL_IP=20/600    (wrong Telegram webhook secret)
# --- behaviour when MongoDB is unreachable ---
# Brute-force counters (*_FAIL_*) always fail CLOSED. Everything else falls back to a strict per-process window with the same limit.
# RL_ON_STORE_ERROR=local      # local (default) | deny  (deny = every category refuses while the store is down)
# RL_STORE_TIMEOUT_MS=800      # max time one limiter call may take
# RL_STORE_COOLDOWN=5          # seconds the store is skipped after a failure before it is probed again
# RL_LOCAL_MAX_KEYS=100000     # memory bound of the fallback window (new keys are refused when full)
# RATE_LIMIT_SALT=             # optional; keys are HMAC-hashed with this (defaults to WEBHOOK_SECRET)

# ---------------- Batch 2: database migrations ----------------
# Migrations run automatically at startup under a MongoDB lock; the app refuses to start (and /readyz stays 503) if one fails.
# MIGRATE_ON_STARTUP=true        # false = only VERIFY at startup; run `python -m migrator` as a release step first
# MIGRATION_LOCK_TTL=120         # seconds a migration lock lease lives (auto-renewed while a migration runs)
# MIGRATION_WAIT_TIMEOUT=180     # how long an instance waits for another instance's migration (or for the DB) before failing to start
# MIGRATION_POLL_INTERVAL=1
# MIGRATION_STEP_RETRIES=2       # retries of one migration step after a connection error

# ---------------- Batch 3: reliability, logging, alerts (all optional; invalid values stop the app at startup) ----------------
# PORT=8000                              # injected by Koyeb
# LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
# LOG_FORMAT=json                        # json (one object per line, for Koyeb) | text (local debugging)
# LOG_PSEUDONYMIZE=true                  # user ids / IPs appear as keyed hashes (h:xxxxxxxxxx). false = raw ids (not recommended)
# LOG_DEDUP_SECONDS=60                   # identical WARNING+ lines inside this window are collapsed (0 = off)
# ALERTS_ENABLED=true                    # Telegram alerts to OWNER_ID for critical failures
# ALERT_COOLDOWN=3600                    # same alert at most once per this many seconds
# ALERT_MAX_PER_HOUR=10                  # hard cap for all alerts
# ALERT_POSTBACK_REJECT_THRESHOLD=20     # rejected Monetag postbacks within ALERT_POSTBACK_REJECT_WINDOW => one alert
# ALERT_POSTBACK_REJECT_WINDOW=300
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000 # fail fast while MongoDB is unreachable
# MONGO_CONNECT_TIMEOUT_MS=5000
# MONGO_SOCKET_TIMEOUT_MS=30000
# MONGO_MAX_POOL_SIZE=50
# DB_HEALTH_INTERVAL=15                  # seconds between background MongoDB pings
# DB_FAIL_THRESHOLD=3                    # consecutive failed pings => "down" (log + one alert)
# STARTUP_TIMEOUT=300                    # how long Telegram initialisation may keep failing at boot before the process exits
# WEBHOOK_REGISTER_TIMEOUT=60            # initial set_webhook retries; afterwards a background task keeps trying
# WEBHOOK_CHECK_INTERVAL=300             # getWebhookInfo check (re-registers if the URL differs, reports Telegram's delivery errors)
# SHUTDOWN_TIMEOUT=15                    # bot/task/database teardown budget after SIGTERM
# HTTP_GRACEFUL_TIMEOUT=10               # in-flight requests may finish this long after SIGTERM (keep the sum below Koyeb's grace period)
# READYZ_CACHE_SECONDS=3                 # /readyz does real work at most this often
# NOFILL_GRACE is ignored (forced off) when APP_ENV=production: it trusts client-reported events.

# ---------------- Application settings (all optional; defaults shown) ----------------
# Links / UX
# LINK_BASE_URL=                         # public base for file links; defaults to BASE_URL (https required in production)
# CHANNEL_URL=                           # "join channel" button in the bot (blank = no button)
# SUPPORT_URL=                           # "support" button in the bot (blank = no button)
# DIRECT_MINIAPP=false                   # open the Mini App directly from file links
# MINIAPP_SHORT_NAME=                    # Mini App short name (needed when DIRECT_MINIAPP=true)
# AUTO_DELETE_SECONDS=120                # delivered files are deleted from the user's chat after this long (0 = never)
# STATS_TZ_OFFSET_MIN=330                # timezone offset (minutes) for daily statistics
# Posting to a channel
# POST_CHANNEL=                          # channel for /post style publishing (blank = disabled)
# POST_CAPTION=                          # caption template
# POST_BUTTON_TEXT=👉 Play Online Free   # button label (max 60 chars)
# POST_MAX_VIDEOS=10                     # videos per post
# POST_DIRECT_LINK=true
# Ad gate
# VERIFY_REQUIRED=true                   # users must complete the ad flow before receiving a file
# ADS_REQUIRED=1                         # ads per file
# AD_CLICK_TO_PLAY=true                  # the user taps to start the ad (more reliable in Telegram WebViews)
# NOFILL_GRACE_FAILS=4                   # development only: legacy no-fill grace threshold (grace is OFF in production)
# MONETAG_SDK_URL=https://libtl.com/sdk.js
# MONETAG_SHOW_LOG=false                 # browser-console debugging of the Monetag SDK
# TADS_SDK_URL=https://w.tads.me/widget.js
# ADS_OPT_INTERVAL=300                   # seconds between optimiser runs (minimum 60)
